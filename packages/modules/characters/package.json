  "description": "Multicharacter CRUD module for the CORA framework.",
  "license": "MIT",
  "homepage": "https://github.com/cora-framework/cora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cora-framework/cora.git",
    "directory": "packages/modules/characters"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
