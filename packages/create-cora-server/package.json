{
  "name": "create-cora-server",
  "version": "0.1.0",
  "description": "Scaffolder for new CORA server projects.",
  "license": "MIT",
  "homepage": "https://github.com/cora-framework/cora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cora-framework/cora.git",
    "directory": "packages/create-cora-server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-cora-server": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cora-framework/lib": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
