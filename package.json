{
  "name": "cora",
  "private": true,
  "description": "CORA - Cyber Online Runtime Architecture. The open-source framework for CyberMP.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.4.0",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@changesets/cli": "^2.31.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
